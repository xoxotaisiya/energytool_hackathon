# Web application
APP_PORT=8000

# Local development through Ollama
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# Docker uses host.docker.internal by default; override only if Ollama is elsewhere.
DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b

# OpenAI-compatible provider (alternative to Ollama)
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://YOUR-PROXY/v1
# LLM_API_KEY=
# LLM_MODEL=qwen/qwen3.8-27b

LLM_TEMPERATURE=0.1
LLM_TIMEOUT=120
RETRIEVER_MODE=bm25
RETRIEVER_DEBUG=0
SESSION_DIR=sessions
