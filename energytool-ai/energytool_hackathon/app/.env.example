# Локально через Ollama. Для этой Windows-машины выбран Qwen3 4B Instruct.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
# Явная Instruct-версия без reasoning. Alias qwen3:4b здесь был thinking-only.
OLLAMA_THINK=false
OLLAMA_NUM_CTX=8192
LLM_TIMEOUT=180
LLM_RETRIES=1
# На платформе используется её значение MAX_TOKENS.
MAX_TOKENS=2048
TEMPERATURE=0.1
CONTEXT_MAX_CHARS=14000
ENERGYTOOL_DEBUG=1
GROUNDED_ANSWERS=1
QUERY_NORMALIZATION=1

# Для API-совместимого прокси (заполнять только реальными данными организаторов)
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://YOUR-PROXY/v1
# LLM_API_KEY=
# LLM_MODEL=qwen/qwen3.8-27b

# Поиск
KB_PATH=
# Гибридный пул кандидатов для последующего отбора точных фактов.
RETRIEVER_MODE=hybrid-ollama
RETRIEVER_DEBUG=1

# Режимы: bm25, auto, dense (API), local (sentence-transformers),
# ollama (локальные embeddings), hybrid, hybrid-local, hybrid-ollama.
OLLAMA_EMB_MODEL=bge-m3
OLLAMA_EMBED_GPU_LAYERS=0
CANDIDATE_K=30
TOP_K=8
DENSE_WEIGHT=0.6
BM25_WEIGHT=0.4
RRF_K=60
RERANKER_ENABLED=0
# RERANKER_BASE_URL=https://YOUR-PROXY/v1
# RERANKER_MODEL=qwen/qwen3-reranker-8b

SOURCE_FIRST_RESPONSES=1
